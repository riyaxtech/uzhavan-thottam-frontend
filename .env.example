# ---------------------------------------------
# Uzhavan Thottam Backend Configuration
# ---------------------------------------------

# Frontend Backend API URL (for deployed backend on Render/Render.com)
VITE_API_URL=https://uzhavan-thottam-backend.onrender.com

# Server Port (for local Node.js server)
PORT=5000

# MongoDB Database Connection String
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/uzhavan_thottam?retryWrites=true&w=majority
MONGODB_URI=

# Admin Email (Recipient of new order notifications)
ADMIN_EMAIL=uzhavanthottam26@gmail.com

# SMTP Email Configuration (Nodemailer)
# For Gmail: Use smtp.gmail.com with a 16-character App Password (not your normal Gmail password)
# How to get App Password: Google Account -> Security -> 2-Step Verification -> App Passwords -> Create "Uzhavan Orders"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=uzhavanthottam26@gmail.com
SMTP_PASS=

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
ADMIN_JWT_SECRET=change_this_to_a_secure_random_secret_in_production

